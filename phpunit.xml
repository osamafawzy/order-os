<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Where the real tests live. The root suites stay for anything that
             genuinely belongs to the application shell rather than a module. -->
        <testsuite name="Modules">
            <directory>Modules/*/tests/Unit</directory>
            <directory>Modules/*/tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>Modules</directory>
        </include>
        <exclude>
            <directory>Modules/*/tests</directory>
            <directory>Modules/*/database</directory>
            <directory>Modules/*/lang</directory>
            <directory>Modules/*/routes</directory>
            <directory>Modules/*/config</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:2fl+Ktvkfl+Fuz4Qp/A75G2RTiWVA/ZoKZvp6fiiM10="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!-- A fixed secret so tokens are deterministic across machines. Test
             only; never a value that reaches a real environment. -->
        <env name="JWT_SECRET" value="testing-secret-testing-secret-testing-secret-0123456789"/>
        <env name="JWT_BLACKLIST_ENABLED" value="true"/>
        <env name="ORDER_CURRENCY" value="USD"/>

        <!-- Every gateway available, with sandbox credentials. Tests that need
             a gateway switched off or unconfigured change config themselves. -->
        <env name="PAYMENT_CREDIT_CARD_ENABLED" value="true"/>
        <env name="PAYMENT_CREDIT_CARD_PUBLIC_KEY" value="pk_test_suite"/>
        <env name="PAYMENT_CREDIT_CARD_SECRET_KEY" value="sk_test_suite"/>
        <env name="PAYMENT_PAYPAL_ENABLED" value="true"/>
        <env name="PAYMENT_PAYPAL_CLIENT_ID" value="paypal_test_client"/>
        <env name="PAYMENT_PAYPAL_CLIENT_SECRET" value="paypal_test_secret"/>
        <env name="PAYMENT_BANK_TRANSFER_ENABLED" value="true"/>
        <env name="PAYMENT_BANK_TRANSFER_IBAN" value="GB82WEST12345698765432"/>
    </php>
</phpunit>
