APP_NAME="Order OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://order-os.ddev.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DDEV defaults. Outside DDEV, point these at any MySQL 8 or use DB_CONNECTION=sqlite.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- API ------------------------------------------------------------------
API_RATE_LIMIT=60
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=10
ORDER_CURRENCY=USD

# --- JWT (php artisan jwt:secret writes JWT_SECRET) -----------------------
JWT_SECRET=
# Access-token lifetime and refresh window, in minutes.
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# --- Payment gateways -----------------------------------------------------
# A gateway is available when it is ENABLED and every credential it needs is
# set. Values below are sandbox placeholders: the bundled gateways simulate
# their vendor, so any non-empty value works locally. Real keys go here, or
# in the database: php artisan payments:gateway <key> --credential=name=value

PAYMENT_CREDIT_CARD_ENABLED=true
PAYMENT_CREDIT_CARD_MODE=sandbox
PAYMENT_CREDIT_CARD_PUBLIC_KEY=pk_test_placeholder
PAYMENT_CREDIT_CARD_SECRET_KEY=sk_test_placeholder

PAYMENT_PAYPAL_ENABLED=true
PAYMENT_PAYPAL_MODE=sandbox
PAYMENT_PAYPAL_CLIENT_ID=paypal_sandbox_client_id
PAYMENT_PAYPAL_CLIENT_SECRET=paypal_sandbox_client_secret

PAYMENT_BANK_TRANSFER_ENABLED=true
PAYMENT_BANK_TRANSFER_BENEFICIARY="Order OS Ltd."
PAYMENT_BANK_TRANSFER_BANK_NAME="Example Bank"
PAYMENT_BANK_TRANSFER_IBAN=GB82WEST12345698765432
